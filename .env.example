# Copy to .env and fill in. Never commit .env.
PORT=8000
HOST=0.0.0.0
# Public base URL of this API (used in file links)
APP_URL=http://127.0.0.1:8000
# Secret for signing file links. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_KEY=
# true shows OTP codes in API responses (development only!)
APP_DEBUG=false

DATABASE_URL=postgresql://lifeline:CHANGE_ME@127.0.0.1:5432/lifeline
REDIS_URL=redis://127.0.0.1:6379

# Private uploads folder (outside any web root)
STORAGE_DIR=./storage

# Comma-separated origins allowed to call the API from a browser (blank = any)
CORS_ORIGINS=

# Path to the Firebase service-account JSON (blank disables push notifications)
FIREBASE_SERVICE_ACCOUNT=

# First admin account created by the seeder
ADMIN_EMAIL=admin@lifeline.app
ADMIN_PASSWORD=

# Encrypted off-site backups (scripts/backup.sh, see docs/DEPLOY.md)
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
BACKUP_KEEP_DAYS=7
